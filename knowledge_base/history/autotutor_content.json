          "difficulty": "easy",
          "cognitive_action": "recall",
          "source_ids": ["autotutor:textbook:westernization:purpose:v1"],
          "generation_mode": "curated"
        },
        {
          "assessment_id": "westernization-purpose-practice-2",
          "objective_id": "history:洋务运动:purpose:v1",
          "kind": "practice",
          "stem": "如何准确理解洋务运动的“自强”“求富”与根本目的之间的关系？",
          "options": [
            {"option_id": "A", "text": "“自强”“求富”是口号和路径，根本目的仍是维护清朝统治", "is_correct": true, "feedback": "正确。你区分了手段、口号和根本目的。", "source_ids": ["autotutor:textbook:westernization:purpose:v1"]},
            {"option_id": "B", "text": "“自强”“求富”证明洋务派要推翻君主制", "is_correct": false, "misconception_code": "means_goal_confusion", "feedback": "洋务派属于清朝统治集团，并不主张推翻君主制。"},
            {"option_id": "C", "text": "“自强”“求富”是洋务运动失败后的历史影响", "is_correct": false, "misconception_code": "purpose_impact_confusion", "feedback": "它们是运动中的口号，不是失败后的影响。"},
