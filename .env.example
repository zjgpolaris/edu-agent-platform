LLM_PROVIDER=bailian
BAILIAN_API_KEY=your_bailian_key_here
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_FAST=qwen3.6-35b-a3b
LLM_MODEL_QUALITY=qwen3.7-plus
LLM_MODEL_FALLBACK=qwen3.7-max-2026-06-08
LLM_MODEL_REASONING=qwen3.7-max-2026-06-08
LLM_MODEL_MULTIMODAL=qwen3.5-omni-flash
LLM_MODEL_MULTIMODAL_QUALITY=qwen3.5-omni-plus
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=2
# Immutable image provenance and hash-bound capability evidence (v1.45).
EDU_AGENT_IMAGE_DIGEST=
EDU_AGENT_LLM_CAPABILITY_MANIFEST_PATH=
EDU_AGENT_LLM_CAPABILITY_MANIFEST_SHA256=
EDU_AGENT_REQUIRE_LLM_EVIDENCE_V2=false
# Comma-separated profile:capability entries. Safe default is empty.
# Example after validated canary: quality:native_structured_output
EDU_AGENT_LLM_ENABLED_CAPABILITIES=
DEBATE_ROLE_TIMEOUT_SECONDS=30

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Learning Assistant v1.30 evidence + gradual rollout (safe defaults)
EDU_AGENT_ASSISTANT_ROLLOUT_CONFIG_VERSION=v1.30-control
EDU_AGENT_ASSISTANT_ROLLOUT_SALT=replace-in-production
EDU_AGENT_ASSISTANT_SEMANTIC_ROUTER_ENABLED=false
EDU_AGENT_ASSISTANT_ROUTER_SHADOW_MODE=true
EDU_AGENT_ASSISTANT_ROUTER_CONFIDENCE_THRESHOLD=0.65
EDU_AGENT_ASSISTANT_SEMANTIC_PERCENT_BPS=0
EDU_AGENT_ASSISTANT_PLANNER_ENABLED=false
EDU_AGENT_ASSISTANT_PLANNER_PERCENT_BPS=0
EDU_AGENT_ASSISTANT_ROLLOUT_KILL_SWITCH=false

# Deterministic evidence verification is always enforced for grounded intents.
# It is a completion safety boundary, not a rollout switch.

# AgentOps runtime readiness window. Eval/demo data is queried separately.
EDU_AGENT_OPS_RUNTIME_WINDOW_HOURS=24
EDU_AGENT_OPS_MIN_RUNTIME_EVENTS=100

# Release evidence. Keep the blind dataset outside the repository.
EDU_AGENT_BLIND_EVAL_PATH=
# Optional external, human-authored OOD corpus. Keep raw data outside Git.
EDU_AGENT_EXTERNAL_OOD_PATH=
EDU_AGENT_REQUIRE_CLEAN_RELEASE_REVISION=true

# Unified Agent Runtime v2 (v1.41; safe rollout defaults)
EDU_AGENT_ENVIRONMENT=local
EDU_AGENT_AUTO_MIGRATE=false
EDU_AGENT_REQUIRE_DIRECT_MIGRATION_URL=false
EDU_AGENT_MIGRATION_LOCK_WAIT_MS=120000
EDU_AGENT_MIGRATION_DDL_LOCK_TIMEOUT_MS=15000
EDU_AGENT_MIGRATION_STATEMENT_TIMEOUT_MS=120000
EDU_AGENT_RUNTIME_V2_ENABLED=false
EDU_AGENT_RUNTIME_V2_SHADOW_MODE=true
EDU_AGENT_RUNTIME_V2_PERCENT_BPS=0
EDU_AGENT_RUNTIME_V2_CONFIG_VERSION=v1.41-history-control
EDU_AGENT_DEPLOYED_COMMIT=
DIRECT_URL=
EDU_AGENT_RUNTIME_ROLLOUT_AGENT_TYPE=history_character
# Optional compatibility file. When empty, Runtime reads hash-bound aggregate
# evidence from the migrated agent_release_evidence table.
EDU_AGENT_RUNTIME_ROLLOUT_EVIDENCE_PATH=
EDU_AGENT_RUNTIME_ROLLOUT_MIN_TERMINAL_RUNS=100
EDU_AGENT_RUNTIME_V2_KILL_SWITCH=false
EDU_AGENT_RUNTIME_V2_PERSIST_EVENTS=true
EDU_AGENT_RUNTIME_V2_ARTIFACT_ENABLED=false
EDU_AGENT_RUNTIME_V2_ARTIFACT_RETENTION_DAYS_NORMAL=7
EDU_AGENT_RUNTIME_V2_ARTIFACT_RETENTION_DAYS_STUDENT_CONTENT=30
EDU_AGENT_RUNTIME_V2_ARTIFACT_RETENTION_DAYS_RESTRICTED=7
EDU_AGENT_RUNTIME_V2_CHECKPOINT_ENABLED=false
EDU_AGENT_RUNTIME_V2_RESUMABLE_ENABLED=false
EDU_AGENT_RUNTIME_V2_RESUMABLE_TTL_HOURS=168
EDU_AGENT_RUNTIME_V2_DYNAMIC_REPLAN_ENABLED=false
EDU_AGENT_RUNTIME_V2_READ_FANOUT_ENABLED=false
EDU_AGENT_RUNTIME_V2_RECOVERY_ENABLED=false
EDU_AGENT_RUNTIME_V2_RECOVERY_POLL_SECONDS=30
EDU_AGENT_RUNTIME_V2_RECOVERY_STALE_SECONDS=600
EDU_AGENT_RUNTIME_V2_LEARNING_ASSISTANT_BPS=0
EDU_AGENT_RUNTIME_V2_AUTOTUTOR_BPS=0
EDU_AGENT_AUTOTUTOR_CONTENT_GATE_MODE=off
EDU_AGENT_AUTOTUTOR_CONTENT_GATE_BPS=0
EDU_AGENT_AUTOTUTOR_CONTENT_GATE_KILL_SWITCH=false
# AutoTutor LangGraph 仅做无副作用 Shadow 重放；默认关闭，不替代 active legacy path
EDU_AGENT_AUTOTUTOR_LANGGRAPH_SHADOW_ENABLED=false
EDU_AGENT_AUTOTUTOR_LANGGRAPH_SHADOW_CONFIG_VERSION=v1.48-shadow
EDU_AGENT_RUNTIME_V2_HISTORY_CHARACTER_BPS=0
EDU_AGENT_RUNTIME_V2_ESSAY_GRADER_BPS=0
EDU_AGENT_RUNTIME_V2_DEBATE_BPS=0

# Langfuse tracing
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=local
LANGFUSE_RELEASE=edu-agent-local
LANGFUSE_CAPTURE_INPUT=true
LANGFUSE_CAPTURE_OUTPUT=true
