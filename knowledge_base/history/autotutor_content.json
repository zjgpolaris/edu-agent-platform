    {
      "objective_id": "history:戊戌变法:cause:v1",
      "entity": "戊戌变法",
      "aspect": "cause",
      "grade": "八年级上册",
      "lesson": "第6课 戊戌变法",
      "target_outcome": "解释戊戌变法失败的主要原因，并区分失败原因与历史影响",
      "explanation": "戊戌变法触犯了以慈禧太后为首的顽固派利益，遭到强烈阻挠。维新派自身力量弱小，缺乏可靠的组织、军队和广泛群众支持，又把希望主要寄托在没有实权的光绪帝身上。慈禧太后发动政变后，变法最终失败。思想启蒙是变法产生的影响，不能当作失败原因。",
      "claims": [
        {
          "claim_id": "wuxu-cause-claim-1",
          "text": "顽固派的强烈阻挠与慈禧太后发动政变，是戊戌变法失败的重要原因。",
          "source_ids": ["autotutor:textbook:wuxu:cause:v1"],
          "objective_aspect": "cause"
        },
        {
          "claim_id": "wuxu-cause-claim-2",
          "text": "维新派力量弱小，缺乏有力支持并依赖没有实权的光绪帝。",
          "source_ids": ["autotutor:textbook:wuxu:cause:v1"],
          "objective_aspect": "cause"
        }
      ],
      "key_points": ["顽固派阻挠", "维新派力量弱小", "依赖无实权的皇帝"],
      "example": "判断一句话时先问：它是在回答“为什么失败”，还是在说明“失败后产生了什么影响”。",
      "practice_items": [
        {
          "assessment_id": "wuxu-cause-practice-1",
          "objective_id": "history:戊戌变法:cause:v1",
          "kind": "practice",
          "stem": "戊戌变法推行一百多天后失败，其失败的主要原因是？",
          "options": [
            {"option_id": "A", "text": "变法触犯顽固派利益，维新派力量弱小，又依赖无实权的皇帝", "is_correct": true, "feedback": "正确。这同时指出了顽固派阻挠和维新派自身力量不足。", "source_ids": ["autotutor:textbook:wuxu:cause:v1"]},
            {"option_id": "B", "text": "变法在社会上起到了思想启蒙作用", "is_correct": false, "misconception_code": "cause_impact_confusion", "feedback": "这是戊戌变法的历史影响，不是它失败的原因。"},
            {"option_id": "C", "text": "外国列强直接出兵镇压了变法", "is_correct": false, "misconception_code": "external_cause_overstatement", "feedback": "变法失败的直接政治力量来自清廷顽固派，不能虚构为列强直接出兵。"},
            {"option_id": "D", "text": "变法已经使清政府走上富强道路", "is_correct": false, "misconception_code": "outcome_counterfactual", "feedback": "变法很快失败，并未使清政府走上富强道路。"}
          ],
          "difficulty": "easy",
          "cognitive_action": "explain",
          "source_ids": ["autotutor:textbook:wuxu:cause:v1"],
          "generation_mode": "curated"
        },
        {
          "assessment_id": "wuxu-cause-practice-2",
          "objective_id": "history:戊戌变法:cause:v1",
          "kind": "practice",
          "stem": "下列哪一项属于戊戌变法失败原因，而不是变法产生的影响？",
          "options": [
            {"option_id": "A", "text": "促进了思想启蒙", "is_correct": false, "misconception_code": "cause_impact_confusion", "feedback": "思想启蒙属于影响。题目要求选择失败原因。"},
            {"option_id": "B", "text": "维新派力量弱小并遭到顽固派阻挠", "is_correct": true, "feedback": "正确。这一项直接解释了变法为什么难以持续。", "source_ids": ["autotutor:textbook:wuxu:cause:v1"]},
            {"option_id": "C", "text": "推动了新式学堂的发展", "is_correct": false, "misconception_code": "cause_measure_confusion", "feedback": "这是变法措施及其后续影响，不是失败原因。"},
            {"option_id": "D", "text": "传播了变法图强思想", "is_correct": false, "misconception_code": "cause_significance_confusion", "feedback": "传播思想属于影响或意义，不是失败原因。"}
          ],
          "difficulty": "easy",
          "cognitive_action": "explain",
          "source_ids": ["autotutor:textbook:wuxu:cause:v1"],
          "variant_of": "wuxu-cause-practice-1",
          "generation_mode": "curated"
        },
        {
          "assessment_id": "wuxu-cause-practice-3",
          "objective_id": "history:戊戌变法:cause:v1",
          "kind": "practice",
          "stem": "从政治力量对比看，戊戌变法为什么难以持续推进？",
          "options": [
            {"option_id": "A", "text": "维新派缺少可靠力量，又受到掌权顽固派的强烈反击", "is_correct": true, "feedback": "正确。力量基础薄弱与顽固派反击共同导致变法难以持续。", "source_ids": ["autotutor:textbook:wuxu:cause:v1"]},
            {"option_id": "B", "text": "维新派已经掌握全国军队和地方政权", "is_correct": false, "misconception_code": "power_base_reversal", "feedback": "维新派并未掌握可靠军队和广泛地方力量。"},
            {"option_id": "C", "text": "变法的思想启蒙作用使其立即失败", "is_correct": false, "misconception_code": "cause_impact_confusion", "feedback": "思想启蒙是影响，不能解释政治上的失败。"},
            {"option_id": "D", "text": "清廷顽固派主动支持全部变法措施", "is_correct": false, "misconception_code": "historical_reversal", "feedback": "顽固派利益受到触动并强烈阻挠变法。"}
          ],
          "difficulty": "medium",
          "cognitive_action": "compare",
          "source_ids": ["autotutor:textbook:wuxu:cause:v1"],
          "variant_of": "wuxu-cause-practice-1",
          "generation_mode": "curated"
        }
      ],
      "exit_ticket_items": [
        {
          "assessment_id": "wuxu-cause-exit-1",
          "objective_id": "history:戊戌变法:cause:v1",
          "kind": "exit_ticket",
          "stem": "某次改革只依靠少数上层人物，既没有可靠军队，也没有广泛社会支持。用戊戌变法的经验判断，这最可能暴露什么问题？",
          "options": [
            {"option_id": "A", "text": "改革力量薄弱，面对既得利益集团反击时难以坚持", "is_correct": true, "feedback": "正确。你把戊戌变法失败原因迁移到了新的改革情境。", "source_ids": ["autotutor:textbook:wuxu:cause:v1"]},
            {"option_id": "B", "text": "改革一定会立即完成思想启蒙", "is_correct": false, "misconception_code": "cause_impact_confusion", "feedback": "思想影响不能代替对失败风险的判断。"},
            {"option_id": "C", "text": "改革措施越少越容易成功", "is_correct": false, "misconception_code": "unsupported_generalization", "feedback": "材料强调的是力量基础，不是措施数量。"},
            {"option_id": "D", "text": "只要皇帝支持，改革必然成功", "is_correct": false, "misconception_code": "single_factor_absolutism", "feedback": "戊戌变法说明只依赖没有实权的皇帝并不足以保障成功。"}
          ],
          "difficulty": "medium",
          "cognitive_action": "apply",
          "source_ids": ["autotutor:textbook:wuxu:cause:v1"],
          "variant_of": "wuxu-cause-practice-1",
          "generation_mode": "curated"
        }
      ],
      "source_refs": [{"source_id": "autotutor:textbook:wuxu:cause:v1", "label": "第6课 戊戌变法", "answer_bearing": true}],
