      "objective_id": "history:洋务运动:purpose:v1",
      "entity": "洋务运动",
      "aspect": "purpose",
      "grade": "八年级上册",
      "lesson": "第4课 洋务运动",
      "target_outcome": "说明洋务运动的根本目的，并区分目的、口号与影响",
      "explanation": "第二次鸦片战争后，洋务派主张利用西方先进技术强兵富国。洋务运动以“自强”“求富”为口号，这些是实现目标的路径；它的根本目的是维护和巩固清政府的统治。客观上促进近代化属于运动产生的影响，不能替代对根本目的的回答。",
      "claims": [
        {"claim_id": "westernization-purpose-claim-1", "text": "洋务运动的根本目的是维护和巩固清政府的统治。", "source_ids": ["autotutor:textbook:westernization:purpose:v1"], "objective_aspect": "purpose"},
        {"claim_id": "westernization-purpose-claim-2", "text": "“自强”“求富”是洋务运动的口号和实现目标的路径。", "source_ids": ["autotutor:textbook:westernization:purpose:v1"], "objective_aspect": "purpose"}
      ],
      "key_points": ["根本目的：维护清朝统治", "口号：自强、求富", "影响不等于目的"],
      "example": "“创办工厂”是做法，“促进近代化”是影响，“维护清朝统治”才是根本目的。",
      "practice_items": [
        {
          "assessment_id": "westernization-purpose-practice-1",
          "objective_id": "history:洋务运动:purpose:v1",
          "kind": "practice",
          "stem": "洋务派掀起洋务运动的根本目的是？",
          "options": [
            {"option_id": "A", "text": "维护和巩固清政府的统治", "is_correct": true, "feedback": "正确。利用西方技术、自强求富都是为维护清朝统治服务。", "source_ids": ["autotutor:textbook:westernization:purpose:v1"]},
            {"option_id": "B", "text": "推翻清政府并建立民主共和国", "is_correct": false, "misconception_code": "movement_goal_confusion", "feedback": "这是革命派的政治目标，不是洋务派的目标。"},
            {"option_id": "C", "text": "让中国立即成为资本主义强国", "is_correct": false, "misconception_code": "purpose_outcome_overstatement", "feedback": "洋务派并不以改变封建统治制度为目标。"},
            {"option_id": "D", "text": "传播民主科学思想", "is_correct": false, "misconception_code": "movement_period_confusion", "feedback": "民主与科学是新文化运动的重要口号，与洋务运动目的不同。"}
